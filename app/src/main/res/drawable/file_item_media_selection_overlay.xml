<!--
  ~ Selection overlay for media tiles (spec 4.2). The thumbnail fills the whole tile, so the checked
  ~ *background* that the list and grid modes use would be hidden behind it and a scrim on top is
  ~ needed instead. Driven by android:duplicateParentState on the view that uses this.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
