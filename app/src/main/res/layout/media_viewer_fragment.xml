<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.media3.ui.PlayerControlView
        android:id="@+id/playerControlView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:controller_layout_id="@layout/media_viewer_player_control"
        app:show_timeout="0"
        app:play_icon="@drawable/exo_icon_play"
        app:pause_icon="@drawable/exo_icon_pause" />

    <!--
      ~ The one view that flies between the grid tile and the viewer, see plan 14 section 3.1.
      ~
      ~ It is an ImageView so that ChangeImageTransform can carry the tile's centerCrop over to
      ~ fitCenter - SubsamplingScaleImageView and PlayerView are not ImageViews and would arrive
      ~ cropped. It stays VISIBLE at all times because ChangeBounds and ChangeImageTransform skip
      ~ anything that is not; what makes it invisible in practice is having no drawable.
      ~
      ~ Below the app bar on purpose: once the enter transition ends, the toolbar icons have to be
      ~ reachable while this is still fading out.
      -->
    <ImageView
        android:id="@+id/transitionImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <FrameLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:theme="?actionBarTheme"
            app:popupTheme="?actionBarPopupTheme" />
    </FrameLayout>
</FrameLayout>
